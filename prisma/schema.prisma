generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

/** Configuração única (id = 1) — dados da empresa exibidos no formulário de reembolso. */
model CompanySettings {
  id                 Int      @id @default(1)
  name               String
  address            String
  cnpj               String
  email              String
  /** Limite inferior esperado de consumo (km/L) para alertas de combustível. */
  fuelMinKmPerLiter  Float    @default(8)
  /** Limite superior esperado de consumo (km/L) para alertas de combustível. */
  fuelMaxKmPerLiter  Float    @default(18)
  updatedAt          DateTime @updatedAt
}

model Reimbursement {
  id                Int          @id @default(autoincrement())
  ownerGoogleSub    String?
  requesterName     String
  requesterAddress  String?
  requesterDocument String
  requesterEmail    String
  bankName          String       @default("não informado")
  bankAgency        String       @default("não informado")
  bankAccount       String       @default("não informado")
  bankAccountType   String       @default("não informado")
  bankAccountHolder String       @default("não informado")
  status            String       @default("enviado")
  totalAmount       Float
  createdAt         DateTime     @default(now())
  expenses          Expense[]
  attachments       Attachment[]
}

model Expense {
  id              Int           @id @default(autoincrement())
  reimbursementId Int
  reimbursement   Reimbursement @relation(fields: [reimbursementId], references: [id], onDelete: Cascade)
  description     String
  expenseLine     String
  accountCode     String?
  /** Data em que a despesa ocorreu (independente de Reimbursement.createdAt). */
  expenseDate     DateTime
  amount          Float
  observation     String?
  /** Odômetro no início do trecho (km) — usado em COMBUSTÍVEL. */
  odometerStart   Float?
  /** Odômetro no fim do trecho (km) — usado em COMBUSTÍVEL. */
  odometerEnd     Float?
  /** Litros abastecidos — usado em COMBUSTÍVEL. */
  litersFilled    Float?
  attachments     Attachment[]
}

model Attachment {
  id              Int           @id @default(autoincrement())
  reimbursementId Int
  reimbursement   Reimbursement @relation(fields: [reimbursementId], references: [id], onDelete: Cascade)
  expenseId       Int?
  expense         Expense?      @relation(fields: [expenseId], references: [id], onDelete: Cascade)
  originalName    String
  storedPath      String
  mimeType        String
  size            Int
}
